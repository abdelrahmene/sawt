# ---------------------------------------------------------------------------
# `npm start` opens the app on :7070 with no credentials at all. Every screen
# works: the staged Meta connection, the inbox, the campaign tables, the
# settings. What needs a key is the part where a model actually answers —
# writing a page, drawing a visual, replying in darija, reading a voice note.
# The badge in the corner of the rail says which mode you are in, so a screen
# can never claim to have called a model it did not.
#
# One key is enough: MODEL_API_KEY.
# ---------------------------------------------------------------------------

# Meta Model API — https://dev.meta.ai
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Meta open weights through Baseten (no Meta account required)
BASETEN_API_KEY=
BASETEN_API_BASE=https://inference.baseten.co/v1

# Which provider the live mode talks to: "meta" or "baseten"
LLM_PROVIDER=meta

# --- Optional: only to drive a REAL Facebook/Instagram account ---------------
# See SETUP.md. Judges do not need any of this.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=v21.0

# --- Optional: domain data source (see "Prior work" in the README) -----------
DROPDZ_API_BASE=
DROPDZ_API_KEY=
