{
  "name": "sawt",
  "version": "0.2.0",
  "description": "Starting a business no longer takes capital or a product — it takes knowing how to run ads. This agent is that profession: product photos in, shop and campaign out, by voice, in Algerian darija.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "cli": "node src/index.js --replay",
    "live": "node src/index.js --live",
    "bench": "node bench/run.mjs",
    "try": "node bench/try-one.mjs",
    "web": "node --disable-warning=ExperimentalWarning src/server.js",
    "baseten": "node --disable-warning=ExperimentalWarning bench/try-baseten.mjs",
    "turn": "node --disable-warning=ExperimentalWarning bench/try-turn.mjs",
    "catalog": "node --disable-warning=ExperimentalWarning bench/make-catalog.mjs"
  },
  "license": "MIT",
  "dependencies": {}
}
